# Required: replace these placeholders before starting the app.
DEVIN_API_KEY=your-devin-api-key
DEVIN_ORGANIZATION_ID=your-devin-organization-id
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Optional: Devin limits and lifecycle settings (defaults shown).
# All values must be positive integers; intervals are in milliseconds.
DEVIN_MAX_SESSION_BUDGET=10
DEVIN_MAX_CONCURRENT_SESSIONS=3
DEVIN_MAX_ATTEMPTS=3
DEVIN_ANALYSIS_MAX_ATTEMPTS=12
DEVIN_RETAINED_POLL_INTERVAL_MS=60000
DEVIN_ORCHESTRATOR_INTERVAL_MS=3000
DEVIN_SUBMITTING_TIMEOUT_SECONDS=60

# Optional: GitHub App authentication. Set all three together or omit all three.
# IDs must be positive integers. Use the complete RSA private key in PEM format,
# quoted across multiple lines to preserve its original header and line breaks.
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----
# replace-with-your-private-key
# -----END RSA PRIVATE KEY-----'

# Optional: dashboard. Set both repository and password to enable it.
# The username defaults to viewer.
# DASHBOARD_REPOSITORY=owner/repository
DASHBOARD_USERNAME=viewer
# DASHBOARD_PASSWORD=your-dashboard-password

# Optional for local runs (default shown); required by Docker Compose.
# For Docker Compose, use /data/devin-remediator.sqlite for persistent storage.
SQLITE_DB_FILEPATH=./devin-remediator.sqlite

# Optional: Debug, Info, Warn, Error, Fatal, or None (default: Info).
LOG_LEVEL=Info
