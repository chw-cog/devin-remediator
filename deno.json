{
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": [".agents/", ".pi/"]
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-ffi --allow-env=DEVIN_API_KEY,DEVIN_ORGANIZATION_ID,GITHUB_WEBHOOK_SECRET,SQLITE_DB_FILEPATH,LIBSQL_JS_DEV --watch src/index.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-ffi --allow-env=DEVIN_API_KEY,DEVIN_ORGANIZATION_ID,GITHUB_WEBHOOK_SECRET,SQLITE_DB_FILEPATH,LIBSQL_JS_DEV src/index.ts",
    "check": "deno fmt --check && deno lint && deno check src/*.ts drizzle.config.ts",
    "test": "deno test --allow-read --allow-ffi --allow-env=LIBSQL_JS_DEV",
    "db:generate": "deno run -A npm:drizzle-kit@1.0.0-rc.5-5935859 generate"
  },
  "imports": {
    "@effect/sql-libsql": "npm:@effect/sql-libsql@4.0.0-rc.115",
    "@libsql/client": "npm:@libsql/client@0.18.0",
    "@octokit/webhooks": "npm:@octokit/webhooks@14.2.0",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.5-5935859",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.5-5935859",
    "effect": "npm:effect@4.0.0-rc.115",
    "hono": "npm:hono@4.13.7"
  }
}
